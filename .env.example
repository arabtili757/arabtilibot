# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=0000000000:AA_PLACEHOLDER_TOKEN_HERE_EXAMPLE

# Comma-separated Telegram User IDs for bot owners (highest administrative level)
OWNER_IDS=5924300834

# Comma-separated Telegram User IDs for administrators
ADMIN_IDS=5364318707

# ==============================================================================
# Marathon & Referral Configuration
# ==============================================================================
# Number of successful referrals required to receive the marathon link
REQUIRED_REFERRALS=3

# Invite link to the closed/private marathon channel
CLOSED_CHANNEL_LINK=https://t.me/+example_closed_marathon_invite_link

# Whether to enforce mandatory subscription checks (true/false)
SUBSCRIPTION_CHECK_ENABLED=true

# Mandatory Channels JSON array format: [{"name": "...", "url": "...", "id": -100...}]
MANDATORY_CHANNELS=[{"name": "Example Channel", "url": "https://t.me/example_channel", "id": -1000000000000}]

# ==============================================================================
# Media & Assets (Telegram file_id strings or leave empty for text-only)
# ==============================================================================
WELCOME_STICKER=
SUCCESS_STICKER=

# ==============================================================================
# Database Configuration (MongoDB Atlas)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=arab_tili_marathon

# Legacy SQLite DB Path (used for one-time migration)
SQLITE_DB_PATH=konkurs.db
